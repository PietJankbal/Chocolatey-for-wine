diff --git a/dlls/sxs/sxs.c b/dlls/sxs/sxs.c
index 150a49a322f..c9a149f4bcf 100644
--- a/dlls/sxs/sxs.c
+++ b/dlls/sxs/sxs.c
@@ -159,6 +159,33 @@ BOOL WINAPI SxsLookupClrGuid(DWORD flags, GUID *clsid, HANDLE actctx, void *buff
     {
         const struct comclassredirect_data *redirect_data = guid_info.lpData;
         const struct clrclass_data *class_data;
+     /*The crash is caused by treating any ACTIVATION_CONTEXT_SECTION_COM_SERVER_REDIRECTION match as a CLR class. In your trace, the found COM redirection entry has:
+
+class redirect: size=120 clrdata_len=0 clrdata_offset=0
+
+clrdata_len == 0 and clrdata_offset == 0 mean this COM server redirection entry contains no CLR class data. It is a plain COM redirection, not a .NET CLR class.
+
+The current code blindly does:
+
+class_data = (void *)((char *)redirect_data + redirect_data->clrdata_offset);
+
+With clrdata_offset == 0, that reinterprets the comclassredirect_data structure itself as a clrclass_data. The fields then read as garbage, producing the enormous len_name / len_version values and the bogus required buffer size of 4122686078. The subsequent memcpy then crashes.
+Fix
+
+Add validation in the SXS_LOOKUP_CLR_GUID_FIND_CLR_CLASS branch. If the redirection entry has no valid CLR data, fail with ERROR_NOT_FOUND instead of parsing it as a CLR class. */   
+        if (!redirect_data->clrdata_len ||
+        !redirect_data->clrdata_offset ||
+        redirect_data->clrdata_offset < sizeof(*redirect_data) ||
+        redirect_data->clrdata_len < sizeof(struct clrclass_data) ||
+        redirect_data->clrdata_offset + redirect_data->clrdata_len > guid_info.ulLength)
+    {
+        FIXME("not a CLR class: clrdata_len=%lu clrdata_offset=%lu ulLength=%lu\n",
+              redirect_data->clrdata_len, redirect_data->clrdata_offset,
+              guid_info.ulLength);
+        retval = FALSE;
+        SetLastError(ERROR_NOT_FOUND);
+        goto out;
+    }
 
         class_data = (void *)((char *)redirect_data + redirect_data->clrdata_offset);
         ptr_name = (char *)class_data + class_data->name_offset;
